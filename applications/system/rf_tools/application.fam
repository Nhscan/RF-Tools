App(
    appid="rf_tools",
    name="RF-Tools",
    apptype=FlipperAppType.EXTERNAL,
    targets=["f7"],
    entry_point="rf_tools_app",
    stack_size=4 * 1024,
    requires=[
        "gui",
        "storage",
        "notification",
        "dialogs",
    ],
    sources=["*.c"],
    fap_category="Sub-GHz",
    fap_author="Nhscan",
    fap_version="1.1",
    fap_description="Capture (Read/Read Raw/Save/Load), Repeater, and a device-abstracted Frequency Analyzer in one app, switchable between internal and external CC1101.",
)
